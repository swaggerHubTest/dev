  "components" : {
    "schemas" : {
      "TVPCacheControl" : {
        "type" : "string",
        "description" : "Specifies the caching strategy to be used for the response.",
        "enum" : [ "NO-CACHE", "PERCENT-50", "PERCENT-75" ],
        "x-enumDescriptions" : {
          "NO-CACHE" : "Travelport cache will be bypassed and live availability results returned.",
          "PERCENT-50" : "Cache will be used if at least 50 percent of the properties / rates are found. Response will be PARTIAL if less than 100 percent found. Response will be HIT if 100 percent found. When less than 50 percent of the properties / rates are not found a live search of all page 1 properties will take place with re-caching of rates. User accepts higher response time as consequence of this header choice.Response will be MISS",
          "PERCENT-75" : "Cache will be used if at least 75 percent of the properties / rates are found. Response will be PARTIAL if less than 100 percent found. Response will be HIT if 100 percent found. When less than 75 percent of the properties / rates are not found a live search of all page 1 properties will take place with re-caching of rates. User accepts higher response time as consequence of this header choice. Response will be MISS"
        }
      },
